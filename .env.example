# ============================================================
# Template konfigurasi SOCA. Salin file ini menjadi ".env" lalu isi nilainya
# sesuai lingkunganmu. JANGAN commit ".env" yang berisi kredensial asli.
# Nilai bertanda WAJIB harus diisi; sisanya boleh memakai default.
# ============================================================

# --- Qdrant (vector database) ---
QDRANT_HOST=isi_alamat_ip_atau_hostname_qdrant     # WAJIB (mis. 10.0.0.5 atau qdrant.contoh.com)
QDRANT_PORT=6333
QDRANT_API_KEY=isi_api_key_qdrant                  # kosongkan bila Qdrant tanpa auth
QDRANT_HTTPS=false                                 # true bila Qdrant memakai HTTPS

# --- LLM chat (default LM Studio lokal; boleh diarahkan ke server lain) ---
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3-8b

# --- SSH ke server Wazuh (dipakai /reload & auto-sync untuk menarik log) ---
SSH_HOST=isi_alamat_ip_server_wazuh                # isi bila memakai /reload
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=isi_password_ssh                      # isi bila memakai /reload
ARCHIVES_PATH=/var/ossec/logs/archives/archives.json

# --- Login aplikasi (form login di UI) ---
APP_USERNAME=admin
APP_PASSWORD=isi_password_login                    # WAJIB

# --- (Opsional) Guardrails Lapis 2 (LLM-as-judge, provider-agnostic via litellm) ---
# GUARDRAILS_MODEL : string model litellm, bebas provider. Contoh:
#   openai/gpt-4o-mini | anthropic/claude-3-5-haiku-latest | gemini/gemini-1.5-flash
#   github/gpt-4o-mini | ollama/llama3 (lokal)
# GUARDRAILS_API_KEY: API key untuk provider model di atas.
# Bila kosong atau gagal init, sistem otomatis memakai Lapis 1 (regex lokal) saja.
GUARDRAILS_MODEL=openai/gpt-4o-mini
GUARDRAILS_API_KEY=

# --- (Kode Sumber Pendukung) Juri RAGAS untuk skrip evaluasi 5c ---
# Bebas provider via endpoint OpenAI-compatible. Default OpenAI.
# Catatan: GitHub Models yang dipakai saat penelitian telah pensiun.
RAGAS_MODEL=gpt-4o-mini
RAGAS_BASE_URL=https://api.openai.com/v1
RAGAS_API_KEY=
